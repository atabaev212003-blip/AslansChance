FROM golang:1.26-bookworm

WORKDIR  /app   
# создаем папку app

COPY . . 
# копирует какой-то файл из Host системы внутри нашего докера

RUN go mod tidy
RUN go build -o /app/exe main.go
#чтобы не забыть ,этот код нужен для того, чтобы скомпилировать код в бинарник один раз и не компилировать при каждом запуске
# как в случае с go run , где происходит компиляция каждый раз , что может занимать большое количество времени каждый раз
CMD ["/app/exe"]